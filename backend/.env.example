# ==============================================
# Vitto Backend - Environment Configuration
# ==============================================
# INSTRUCTIONS:
# 1. Copy this file to .env (git will ignore it)
# 2. Fill in your actual values below
# 3. NEVER commit the real .env to Git

# ----- Server -----
PORT=5000
NODE_ENV=development

# ----- PostgreSQL -----
# Option A: Local (development)
POSTGRES_URI=postgresql://postgres:yourpassword@localhost:5432/vitto_db

# Option B: Cloud (production — e.g. Supabase/Neon/Render Postgres)
# POSTGRES_URI=postgresql://user:password@host:5432/dbname?sslmode=require

# ----- MongoDB -----
# Option A: Local (development)
MONGO_URI=mongodb://localhost:27017/vitto_otp

# Option B: Cloud (production — e.g. MongoDB Atlas)
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/vitto_otp

# ----- JWT -----
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
